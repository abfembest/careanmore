# Copy to .env and fill in. Never commit your real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.careanmore.co.uk

# Database (SQLite by default). Example for PostgreSQL:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=careanmore
# DATABASE_USER=careanmore
# DATABASE_PASSWORD=secret
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Email for enquiry notifications
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Care Anmore website <no-reply@careanmore.co.uk>
# ENQUIRY_NOTIFY_EMAILS=office@careanmore.co.uk

# Security: sign-in lockout and bot protection
# LOGIN_FAILURE_LIMIT=5
# LOGIN_LOCKOUT_MINUTES=15
# ENQUIRY_RATE_LIMIT=5
# Set to True behind ngrok / Nginx / a hosting platform so limits use real visitor IPs
# DJANGO_TRUST_X_FORWARDED_FOR=True
# Move Django admin to a private address
# DJANGO_ADMIN_URL=office-7f3k/
# Optional Cloudflare Turnstile (free): https://www.cloudflare.com/products/turnstile/
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
